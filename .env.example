# ================================================================
# Code4Ever — environment configuration
# ================================================================
# Copy to `.env` and fill in. Never commit the real file (it is git-ignored).

# ---------- Supabase ----------
# Public (safe to ship in the browser bundle)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server side. SUPABASE_URL/SUPABASE_ANON_KEY fall back to the VITE_* values above.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# SECRET — bypasses Row Level Security. Required for the backend to verify sessions and to
# grant the protected `supporter_tier` (Spark perks). NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------- Application ----------
# Public origin of the deployment. Used for OAuth redirect URIs and as the exact
# postMessage target origin of the GitHub OAuth popup.
APP_URL=""
PORT="3000"
# Number of proxies in front of the app (Cloud Run / Vercel = 1). Wrong values make the
# per-IP rate limiter either spoofable or useless.
TRUST_PROXY="1"

# ---------- GitHub OAuth ----------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Signs the OAuth `state` parameter (CSRF protection). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_SECRET=""

# ---------- EveryChat (LLM proxy) ----------
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# ---------- Donations (ByNoGame) ----------
BYNOGAME_STREAM_ID=""
BYNOGAME_DONATE_URL=""
# Shared secret for the inbound donation webhook. Senders must include
#   X-C4E-Signature: sha256=<hex HMAC-SHA256 of the raw request body>
# The webhook is disabled while this is empty.
BYNOGAME_WEBHOOK_SECRET=""
# Optional static token for server-to-server administration (header: X-Admin-Token).
ADMIN_API_TOKEN=""
# Where the donation ledger JSON is stored (defaults to ./data)
DATA_DIR=""

# ---------- E-mail (admin mail console) ----------
# Powers the "E-postalar" tab in the admin panel: reading the operator mailbox over IMAP and
# sending mail to a member over SMTP. Both are OPTIONAL — without them the endpoints answer
# 503 and the admin UI says the feature is not configured.
#
# SECURITY: these credentials stay on the server. They are never sent to the browser, never
# logged, and never echoed in an API response. Connection targets come from here only, so a
# request can never point the mailer at another host.

# SMTP — sending. Port 465 implies TLS; 587 upgrades with STARTTLS.
MAIL_SMTP_HOST=""
MAIL_SMTP_PORT="465"
MAIL_SMTP_SECURE=""
MAIL_SMTP_USER=""
MAIL_SMTP_PASS=""
# Envelope sender. Defaults to MAIL_SMTP_USER when empty.
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="Code4Ever"

# IMAP — reading. User/password fall back to the SMTP pair when left empty.
#
# The inbox is pulled by the admin pressing "sync", which opens ONE connection, fetches, and
# closes it. That works on a serverless host too — what a frozen function cannot do is hold a
# connection open BETWEEN requests. Synced messages are cached in Supabase and every later
# view is served from there without touching the mail server.
MAIL_IMAP_HOST=""
MAIL_IMAP_PORT="993"
MAIL_IMAP_SECURE=""
MAIL_IMAP_USER=""
MAIL_IMAP_PASS=""

# How long one sync may spend downloading message bodies, in milliseconds (default 45000,
# floor 3000, ceiling 280000). Headers are always saved first, so if the budget runs out the
# sync is still stored — the remaining bodies download when those messages are opened.
# Keep this comfortably under the platform's function time limit (see vercel.json
# maxDuration); raise both together if a large mailbox keeps coming back truncated.
MAIL_SYNC_BUDGET_MS=""

# Optional override for the inline logo attached to outgoing mail.
# Defaults to the bundled public/email-logo.png, rebuilt with:
#   node scripts/build-email-logo.mjs
MAIL_LOGO_PATH=""

# ---------- Integrations ----------
# Comma separated allow-list of hosts the Jubbio webhook relay may contact.
JUBBIO_ALLOWED_HOSTS="jubbio.com,*.jubbio.com"

# ---------- Unused / legacy ----------
GEMINI_API_KEY=""

# --- Bildirim e-postaları ---------------------------------------------------
# Bekleyen bildirimler üyeye TEK bir özet e-posta olarak gönderilir. Gönderime sunucu karar
# verir: bildirim tablosu servis rolüyle okunur, istemciden gelen hiçbir şey tetikleyici
# değildir. Aksi hâlde herkes istediğine platformun alan adından posta yollatabilirdi.
#
# Zamanlayıcının paylaşılan sırrı. Tanımlı DEĞİLSE cron yolu tamamen kapanır ve dağıtımı
# yalnızca yönetici elle tetikleyebilir. Vercel Cron bunu Authorization: Bearer ile,
# kendi kurduğunuz bir cron X-Cron-Secret ile gönderebilir.
#   openssl rand -hex 32
MAIL_NOTIFY_CRON_SECRET=""

# Bu yaştan eski bildirimler artık e-postalanmaz, yalnızca kuyruktan düşürülür (varsayılan 48).
MAIL_NOTIFY_MAX_AGE_HOURS=""

# NOT — cron sıklığı: vercel.json içindeki zamanlama günde bir ("0 7 * * *") olarak geliyor,
# çünkü Vercel Hobby planı yalnızca günlük cron'a izin verir ve daha sık bir ifade dağıtımı
# hata ile durdurur. Pro planındaysanız bunu "0 * * * *" (saatlik) yapmak tek satırlık bir
# değişikliktir ve bildirimler çok daha hızlı ulaşır.

# --- Lanux ile giriş (OIDC) -------------------------------------------------
# Bu dört değer TANIMSIZSA Lanux girişi tamamen kapalıdır: giriş ekranındaki düğme
# çalışmaz ve /api/auth/lanux/* uçları "yapılandırılmamış" döner. GitHub girişi
# etkilenmez, yani eksik yapılandırma uygulamayı kilitlemez.
#
# Lanux Developer Console > Uygulamalar > Yeni Uygulama ile oluşturulur.
# Yetkili yönlendirme adresi, LANUX_REDIRECT_URI ile HARFİ HARFİNE aynı olmalıdır;
# sağlayıcı bu karşılaştırmayı tam eşleşme olarak yapar.
LANUX_ISSUER="https://account.lanux.online"
LANUX_CLIENT_ID=""
LANUX_CLIENT_SECRET=""
LANUX_REDIRECT_URI="https://lanux.online/api/auth/lanux/callback"

# Akış paketini (state + nonce + PKCE doğrulayıcısı) mühürleyen ve veritabanındaki
# yenileme belirteçlerini şifreleyen sır.
#
# ÜRETİMDE MUTLAKA SABİT BİR DEĞER VERİN. Tanımsızsa süreç başına rastgele üretilir;
# sunucusuz ortamda her çağrı yeni bir süreç olduğu için o hâlde giriş akışı yarıda
# kopar ve daha önce saklanmış yenileme belirteçleri çözülemez hâle gelir.
# Değeri döndürmek yarım kalan akışları düşürür ve saklı yenileme belirteçlerini
# geçersiz kılar — üyeler Lanux'u yeniden bağlar, hesapları etkilenmez.
#   openssl rand -hex 32
LANUX_STATE_SECRET=""
